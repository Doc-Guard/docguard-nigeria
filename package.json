{
  "name": "docguard",
  "private": true,
  "version": "1.0.0",
  "description": "AI-Powered Loan Compliance & Origination Platform for Nigeria (LMA/CAC/KYC)",
  "author": "Doc-Guard Team",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "clean": "rm -rf dist dist-electron release",
    "dev": "node scripts/generate-secrets.cjs && vite",
    "build": "bun run clean && node scripts/generate-secrets.cjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "build:electron": "node scripts/generate-secrets.cjs && node scripts/build-electron.cjs",
    "electron:dev": "concurrently -k \"node scripts/generate-secrets.cjs && bun run dev\" \"wait-on tcp:5173 && bun run build:electron && electron .\"",
    "electron:build": "node scripts/generate-secrets.cjs && bun run build && bun run build:electron && electron-builder"
  },
  "dependencies": {
    "@google/genai": "^1.34.0",
    "@supabase/supabase-js": "^2.89.0",
    "@vercel/speed-insights": "^1.0.12",
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^11.0.2",
    "jspdf": "^3.0.4",
    "lucide-react": "^0.562.0",
    "mustache": "^4.2.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.11.0",
    "recharts": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/jspdf": "^1.3.3",
    "@types/mustache": "^4.2.6",
    "@types/node": "^22.19.3",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.27.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.3",
    "vite": "^6.4.1",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.docguard.nigeria",
    "productName": "DocGuard",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "snap"
      ],
      "category": "Office",
      "icon": "build/icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    }
  }
}